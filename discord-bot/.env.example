# Discord Developer Portal -> deine Application -> "Bot" -> Token
DISCORD_TOKEN=

# Discord Developer Portal -> deine Application -> "General Information" -> Application ID
CLIENT_ID=

# Optional: Server (Guild) ID, in dem der Slash-Command SOFORT verfuegbar sein
# soll (Rechtsklick auf den Servernamen in Discord -> "ID kopieren", dafuer
# muss der Entwicklermodus in den Discord-Einstellungen aktiv sein). Ohne
# GUILD_ID wird der Command global registriert - das kann bis zu einer
# Stunde dauern, bis er in Discord auftaucht.
GUILD_ID=

# Gleiche Werte wie in js/config.js dieses Repos (Project URL + anon public
# Key aus Supabase -> Project Settings -> API). Nur lesender Zugriff noetig.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional, nur fuer die Schreib-Befehle /mdrdb-verkaufen und
# /mdrdb-besitzer noetig: Supabase -> Project Settings -> API ->
# "service_role" Secret (NICHT der "anon" Key!). Bleibt geheim - niemals
# ins Frontend/GitHub Pages einbauen, nur in dieser .env auf dem Server.
SUPABASE_SERVICE_ROLE_KEY=
